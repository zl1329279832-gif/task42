<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.web.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pdai.javafx.app.controller.WebviewController"
      prefHeight="600.0" prefWidth="834.0">

    <!-- Toolbar: URL bar + Bookmark actions -->
    <HBox spacing="5.0" alignment="CENTER_LEFT" style="-fx-padding: 5;">
        <children>
            <Button text="Baidu" onAction="#clickPageBBtn" />
            <Button text="Bing" onAction="#clickPageABtn" />
            <TextField fx:id="urlField" promptText="Enter URL..." HBox.hgrow="ALWAYS" prefWidth="400.0" />
            <Button text="Bookmark" onAction="#onAddBookmark" />
            <Button text="Delete" onAction="#onDeleteBookmark" />
            <Button text="Clear History" onAction="#onClearHistory" />
        </children>
    </HBox>

    <!-- Main content: WebView + side panel -->
    <HBox VBox.vgrow="ALWAYS">
        <children>
            <!-- WebView area -->
            <StackPane HBox.hgrow="ALWAYS">
                <children>
                    <WebView fx:id="webView" prefHeight="500.0" prefWidth="600.0" />
                    <ProgressIndicator fx:id="progressIndicator" maxHeight="37.0"
                        blendMode="EXCLUSION" prefHeight="37.0" prefWidth="600.0">
                        <opaqueInsets>
                            <Insets />
                        </opaqueInsets>
                    </ProgressIndicator>
                </children>
            </StackPane>

            <!-- Side panel: Search + Bookmarks + History -->
            <VBox prefWidth="230.0" spacing="5.0" style="-fx-padding: 5; -fx-border-color: #ccc; -fx-border-width: 0 0 0 1;">
                <children>
                    <!-- Search -->
                    <Label text="Search Bookmarks:" />
                    <TextField fx:id="searchField" promptText="Type to search..." />

                    <!-- Bookmark list -->
                    <Label text="Bookmarks:" />
                    <ListView fx:id="bookmarkList" VBox.vgrow="ALWAYS" prefHeight="180.0" />

                    <!-- History list -->
                    <Label text="Recent Visits:" />
                    <ListView fx:id="historyList" VBox.vgrow="ALWAYS" prefHeight="180.0" />
                </children>
            </VBox>
        </children>
    </HBox>
</VBox>
